# LangGraph Configuration
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=agent
# Support site that mints agent tokens. Defaults to https://support.access-ci.org.
# For local development against ddev, run `pnpm dev`, open
# https://chat.accessmatch.ddev.site, and set:
#   NEXT_PUBLIC_API_URL=https://chat.accessmatch.ddev.site/api/v1
#   NEXT_PUBLIC_SUPPORT_URL=https://accessmatch.ddev.site
NEXT_PUBLIC_SUPPORT_URL=
# Program whose settings this build uses (see src/config/programs).
NEXT_PUBLIC_PROGRAM=access
# Optional. Required for Agent Builder deployments.
# Set to "langsmith-api-key" when using a LangSmith PAT.
NEXT_PUBLIC_AUTH_SCHEME=
